# The bridge's LAN address. You can find it in the Hue app under Settings > Bridges.
HUE_BRIDGE_IP=192.168.1.50

# Run `cargo run -- authorize` after pressing the bridge button; paste its output here.
HUE_APP_KEY=

# Run `cargo run -- list-lights` to find this value.
HUE_LIGHT_ID=

# Optional tuning.
# POTATO_POLL_SECONDS=3
# PULSE_ON_MS=450
# PULSE_GAP_MS=180
# PULSE_MAX_BRIGHTNESS=100
# Set one of these to change the pulse itself. Leave both commented to use the
# light's existing colour. Temperature is in Kelvin, for example 2700 or 4000.
# PULSE_TEMPERATURE_K=2700
# PULSE_COLOR=#FF9A20
# POTATO_STATE_FILE=potato-hue-state.json
